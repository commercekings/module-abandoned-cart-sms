<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <commercekings_abandoned_cart>
            <sms>
                <enabled>0</enabled>
                <delay_minutes>60</delay_minutes>
                <max_per_hour>0</max_per_hour>
                <text>{{store}}: you left something in your cart. Complete your order: {{link}} Reply STOP to stop</text>
            </sms>
        </commercekings_abandoned_cart>
    </default>
</config>
