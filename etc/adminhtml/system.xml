<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="commercekings_abandoned_cart">
            <group id="sms" translate="label comment" sortOrder="15" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Text message reminders</label>
                <fieldset_css>commercekings-config-section</fieldset_css>
                <comment><![CDATA[A text to the number the shopper gives at checkout, next to the reminder email, once per cart. It needs an SMS provider module (Notifications > Delivery) and the checkbox text for text messages (Notifications > Consent for an address); only then do the phone field and the checkbox appear at checkout. Quiet hours and STOP replies apply (Notifications).]]></comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="delay_minutes" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Send after (minutes)</label>
                    <comment>Minutes without cart activity. Default: 60.</comment>
                    <validate>required-entry validate-digits validate-greater-than-zero</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="max_per_hour" translate="label comment" type="text" sortOrder="30" showInDefault="1">
                    <label>Maximum texts per hour</label>
                    <comment>Your SMS provider's limit, across all stores. 0: no limit.</comment>
                    <validate>validate-digits</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="text" translate="label comment" type="textarea" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Text</label>
                    <comment><![CDATA[Placeholders: {{store}}, {{name}} (first name, may be empty), {{product}}, {{total}}, {{link}} (the cart page). Name your store and keep "Reply STOP to stop". 160 characters fit one text (70 with an emoji or a character outside the basic set); a longer one is sent as several.]]></comment>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
