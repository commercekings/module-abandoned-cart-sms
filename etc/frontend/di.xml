<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Luma checkout: the text reminder checkbox under the shipping phone, after Magento's own address processors -->
    <type name="Magento\Checkout\Block\Onepage">
        <arguments>
            <argument name="layoutProcessors" xsi:type="array">
                <item name="ckAbandonedCartSmsConsent" xsi:type="object">CommerceKings\AbandonedCartSms\Model\Checkout\SmsConsentLayout</item>
            </argument>
        </arguments>
    </type>
</config>
