{
    "name": "commercekings/module-abandoned-cart-sms",
    "description": "SMS abandoned cart reminders for Magento 2: a text next to the reminder email, with a consent checkbox for the number, quiet hours and STOP replies - on commercekings/module-abandoned-cart, sent by any SMS provider module.",
    "type": "magento2-module",
    "license": "MIT",
    "authors": [
        {
            "name": "CommerceKings"
        }
    ],
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "^103.0.4",
        "commercekings/module-abandoned-cart": "^0.1",
        "commercekings/module-notification": "^0.1",
        "magento/module-checkout": "^100.4",
        "magento/module-customer": "^103.0",
        "magento/module-quote": "^101.2",
        "magento/module-store": "^101.1"
    },
    "suggest": {
        "commercekings/module-notification-twilio": "Sends the texts (Twilio SMS); any module that provides an sms provider for CommerceKings_Notification works"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "CommerceKings\\AbandonedCartSms\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "archive": {
        "exclude": [
            "/Test/",
            "/.github/",
            "/.gitignore",
            "/.gitattributes"
        ]
    },
    "homepage": "https://github.com/commercekings/module-abandoned-cart-sms",
    "support": {
        "issues": "https://github.com/commercekings/module-abandoned-cart-sms/issues",
        "source": "https://github.com/commercekings/module-abandoned-cart-sms"
    }
}
